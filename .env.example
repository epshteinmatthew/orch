# Orchestrator keys (all optional; can also be entered in the UI)
CURSOR_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Point the ChatGPT orchestrator at any OpenAI-compatible server (Ollama, LM Studio, OpenRouter…)
ORCH_OPENAI_BASE_URL=

# Optional
# cursor | claude | gemini | openai
ORCH_ORCHESTRATOR=cursor
ORCH_MAX_ITERS=15
ORCH_PORT=8787
ORCH_HOST=127.0.0.1

# Cursor model id for the orchestrator agent
ORCH_CURSOR_MODEL=composer-2.5

# OpenCode worker model as provider/model (blank = OpenCode's default)
ORCH_OPENCODE_MODEL=
# Max time for a single OpenCode turn (ms)
ORCH_WORKER_TIMEOUT_MS=1800000
